# Base de eventos (Redis por REST). Sin estas variables, en desarrollo se usa .data/lab01-log.json.
# Nunca subas los valores reales al repositorio.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV / Upstash por Marketplace inyecta KV_REST_API_URL y KV_REST_API_TOKEN: también se aceptan.)

# Opcional: URL pública del sitio, para que el canonical sea absoluto.
NEXT_PUBLIC_SITE_URL=
